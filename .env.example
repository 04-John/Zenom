# Database (Neon)
DATABASE_URL="postgresql://user:password@host/zenom?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Admin seed (used only by `prisma db seed`). Set both, or leave
# ADMIN_SEED_PASSWORD unset to have the seed script generate and print a
# random one-time password instead.
ADMIN_SEED_EMAIL="zenomart.studio@gmail.com"
ADMIN_SEED_PASSWORD=""

# Email (Resend)
RESEND_API_KEY=""
ORDER_NOTIFICATION_EMAIL="zenomart.studio@gmail.com"

# WhatsApp handoff (business number, E.164 format, digits only)
WHATSAPP_BUSINESS_NUMBER="2349048528199"

# Image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Feature flags — flip these when Abstract / Spaces are ready to launch
NEXT_PUBLIC_ABSTRACT_LIVE="false"
NEXT_PUBLIC_SPACES_LIVE="false"

# Error monitoring (Sentry)
SENTRY_DSN=""
