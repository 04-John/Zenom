// Zenom Studio — Prisma schema
// Same relational discipline as the Heavens Creative structural reference:
// explicit models and constraints, no JSON-blob shortcuts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Pillar {
  PORTRAITS
  ABSTRACT
  SPACES
}

enum ProductStatus {
  AVAILABLE
  SOLD_OUT
  DRAFT
  COMING_SOON
}

enum OrderStatus {
  PENDING
  AWAITING_DEPOSIT
  CONFIRMED
  IN_PRODUCTION
  READY
  COMPLETED
  CANCELLED
}

// Drives which price table applies (see src/lib/pricing.ts): PORTRAIT uses
// the Portrait table, the other three share the Abstract table.
enum ProductCategory {
  PORTRAIT
  GEOMETRIC
  MINIMALISTIC
  FIGURATIVE
}

enum DeliveryZone {
  KADUNA
  OUTSIDE
}

// Commission requests (/commission): what the customer asked Samuel to draw with.
enum Medium {
  CHARCOAL
  GRAPHITE
  COLOUR_PENCIL
}

// Progress photos Samuel shares on an order, in drawing order.
enum PhotoStage {
  SKETCH
  SHADING
  FINISHED
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  passwordHash   String?
  role           Role      @default(CUSTOMER)
  emailVerified  DateTime?
  // Bumped on every password reset/change. Sessions carry the value they
  // were signed in with; an older value is signed out (see src/lib/auth.ts).
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  orders         Order[]

  @@index([email])
}

// Signup email verification tokens. identifier = the user's email.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id          String          @id @default(cuid())
  // Derived from `category` on write (PORTRAIT -> PORTRAITS, the rest ->
  // ABSTRACT); kept so storefront queries and SPACES gating stay simple.
  pillar      Pillar
  category    ProductCategory @default(PORTRAIT)
  name        String
  slug        String          @unique
  description String
  // No per-product price: every piece is priced from src/lib/pricing.ts
  // (category table x size + optional framing).
  status      ProductStatus   @default(DRAFT)
  archiveCode String? // Zenom Archive numbering, e.g. "ZS-001"
  // "Show on home page": adds the piece to the home hero slideshow.
  featured    Boolean         @default(false)
  images      ProductImage[]
  orderItems  OrderItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([pillar, status])
  @@index([category, status])
  @@index([featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  order     Int     @default(0)

  @@index([productId])
}

// The 6 available sizes (seeded from SIZES in src/lib/pricing.ts). Prices
// live in pricing.ts, not here. New order items snapshot the size label +
// index directly; sizeId is kept only so pre-redesign orders stay linked.
model PortraitSize {
  id         String      @id @default(cuid())
  label      String // "8×12" ... "24×36"
  widthIn    Int
  heightIn   Int
  sortOrder  Int         @default(0)
  orderItems OrderItem[]
}

model Order {
  id               String       @id @default(cuid())
  orderNumber      String       @unique // "ZS-0001"
  userId           String?
  user             User?        @relation(fields: [userId], references: [id])
  status           OrderStatus  @default(PENDING)
  customerName     String
  customerEmail    String
  customerPhone    String
  deliveryAddress  String
  notes            String?
  // All money in kobo, recomputed server-side from src/lib/pricing.ts.
  delivery         DeliveryZone @default(KADUNA)
  deliveryFee      Int          @default(0)
  subtotal         Int          @default(0)
  total            Int
  deposit          Int          @default(0) // 50% non-refundable
  items            OrderItem[]
  photos           OrderPhoto[]
  emailSent        Boolean      @default(false)
  whatsappOpened   Boolean      @default(false)
  // Commission requests: the date the customer needs the piece by (date only).
  neededBy         DateTime?    @db.Date
  // Taps in the customer's app. They are flags for Samuel, never a status
  // change: only Samuel moves an order forward (e.g. after checking his bank).
  quoteAcceptedAt  DateTime?
  customerPaidAt   DateTime? // "I've made the transfer"
  sketchApprovedAt DateTime?
  sketchFeedback   String? // "Ask for changes" text, latest request only
  sketchFeedbackAt DateTime?
  // Set when the order is marked COMPLETED (delivered and paid); shown on the
  // certificate. Cleared if the order is moved back.
  deliveredAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId])
  @@index([status])
}

// Sketch / shading / finished photos Samuel uploads on an order (Cloudinary
// URLs). The customer sees them on their order and approves the sketch.
model OrderPhoto {
  id        String     @id @default(cuid())
  orderId   String
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage     PhotoStage
  url       String
  createdAt DateTime   @default(now())

  @@index([orderId, stage])
}

// Studio-wide details Samuel edits in the Studio tab. One row (id "studio");
// read through src/lib/studio-settings.ts, which supplies defaults when the
// row doesn't exist yet.
model StudioSettings {
  id                String   @id @default("studio")
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  quoteHours        Int      @default(24) // "Samuel sends your quote within 24 hours"
  drawingDays       Int      @default(10) // "Ready in about 10 days" once drawing starts
  updatedAt         DateTime @updatedAt
}

model OrderItem {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  // Legacy link (pre-redesign orders only); new items leave this null.
  sizeId            String?
  size              PortraitSize? @relation(fields: [sizeId], references: [id])
  sizeLabel         String? // e.g. "16×20" (legacy rows: "16x20")
  sizeIndex         Int? // 0-5 into SIZES; null for legacy sizes with no equivalent
  framed            Boolean       @default(false)
  // Extra people on a portrait: +10,000 each after the first.
  subjectCount      Int           @default(1)
  notes             String?
  // Commission requests only (the item points at a hidden per-category
  // "commission-<category>" product; see src/lib/commission.ts).
  medium            Medium?
  referencePhotoUrl String?
  // Per-item price snapshot in kobo (artwork + framing + extra subjects).
  unitPrice         Int           @default(0)
  // Legacy columns, kept so old orders stay readable. New orders: quantity 1, subtotal = unitPrice.
  quantity          Int           @default(1)
  subtotal          Int           @default(0)

  @@index([orderId])
}
